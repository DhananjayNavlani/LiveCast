rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function memberPath(g, email) {
      return /databases/$(database)/documents/groups/$(g)/members/$(email);
    }

    function isMember(g) {
      return isVerified()
        && g is string
        && exists(memberPath(g, myEmail()));
    }

    function roleIn(g, roles) {
      return isVerified()
        && g is string
        && exists(memberPath(g, myEmail()))
        && get(memberPath(g, myEmail())).data.role in roles;
    }

    function isEnrolledHostOf(g) {
      return isSignedIn()
        && g is string
        && exists(/databases/$(database)/documents/devices/$(request.auth.uid))
        && get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.get('groupId', null) == g;
    }

    // Users collection - authenticated users can read all, only owner can write
    // User document contains nested 'device' object with device info
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Calls collection - WebRTC signaling (authenticated users only)
    match /calls/{callId} {
      allow read, write: if request.auth != null;

      // ICE candidates subcollections
      match /offerCandidates/{candidateId} {
        allow read, write: if request.auth != null;
      }

      match /answerCandidates/{candidateId} {
        allow read, write: if request.auth != null;
      }
    }

    // Rooms collection - online tracking (authenticated users only)
    match /rooms/{roomId} {
      allow read, write: if request.auth != null;
    }

    // Config collection - read only for authenticated users
    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only via Firebase Console
    }

    // Groups collection
    match /groups/{g} {
      allow read: if isMember(g) || isEnrolledHostOf(g);
      allow create: if isVerified()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'ownerUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt'])
        && existsAfter(memberPath(g, myEmail()))
        && getAfter(memberPath(g, myEmail())).data.role == 'owner';
      allow update: if roleIn(g, ['owner'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if false;

      match /members/{email} {
        allow read: if isMember(g) || isEnrolledHostOf(g);
        allow create: if (roleIn(g, ['owner']) || isBootstrapMember(g, email))
          && validMemberWrite(email);
        allow update: if roleIn(g, ['owner'])
          && email != myEmail()
          && request.resource.data.email == resource.data.email
          && validMemberWrite(email);
        allow delete: if roleIn(g, ['owner'])
          && email != myEmail();
      }
    }

    function isBootstrapMember(g, email) {
      return isVerified()
        && !exists(/databases/$(database)/documents/groups/$(g))
        && existsAfter(/databases/$(database)/documents/groups/$(g))
        && getAfter(/databases/$(database)/documents/groups/$(g)).data.ownerUid == request.auth.uid
        && email == myEmail()
        && request.resource.data.role == 'owner';
    }

    function validMemberWrite(email) {
      return request.resource.data.email == email
        && email == email.lower()
        && request.resource.data.role in ['owner', 'supervisor', 'device']
        && request.resource.data.keys().hasAll(['email', 'role', 'addedAt'])
        && request.resource.data.keys().hasOnly(['email', 'role', 'name', 'addedAt']);
    }

    // Collection group for members
    match /{path=**}/members/{email} {
      allow read: if isVerified() && resource.data.email == myEmail();
    }

    // Devices collection
    match /devices/{d} {
      allow read: if request.auth != null && (
        request.auth.uid == d ||
        roleIn(resource.data.groupId, ['owner', 'supervisor'])
      );
      allow create: if request.auth != null
        && request.auth.uid == d
        && request.resource.data.hostUid == d
        && roleIn(request.resource.data.groupId, ['device'])
        && request.resource.data.keys().hasAll(['groupId', 'hostUid', 'displayName', 'model', 'enrolledAt'])
        && request.resource.data.keys().hasOnly(['groupId', 'hostUid', 'displayName', 'model', 'enrolledAt', 'accessibility', 'notifications', 'statusAt'])
        && (!('accessibility' in request.resource.data) || request.resource.data.accessibility in ['on', 'off'])
        && (!('notifications' in request.resource.data) || request.resource.data.notifications in ['on', 'off']);
      allow update: if isDeviceSelfReport(d) || isDeviceReenroll(d) || isDeviceOwnerRemoval();
      allow delete: if false;

      match /private/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == d;
      }

      match /appEvents/{e} {
        allow read: if request.auth != null
          && resource.data.groupId == get(/databases/$(database)/documents/devices/$(d)).data.get('groupId', null)
          && roleIn(resource.data.groupId, ['owner', 'supervisor']);
        allow create: if request.auth != null
          && request.auth.uid == d
          && exists(/databases/$(database)/documents/devices/$(d))
          && get(/databases/$(database)/documents/devices/$(d)).data.get('groupId', null) != null
          && request.resource.data.groupId == get(/databases/$(database)/documents/devices/$(d)).data.groupId
          && request.resource.data.keys().hasAll(['type', 'packageName', 'label', 'at', 'detectedLate', 'groupId'])
          && request.resource.data.keys().hasOnly(['type', 'packageName', 'label', 'at', 'detectedLate', 'groupId'])
          && request.resource.data.type in ['installed', 'removed']
          && request.resource.data.detectedLate is bool
          && request.resource.data.packageName is string
          && request.resource.data.label is string
          && request.resource.data.at is timestamp
          && request.resource.data.at <= request.time + duration.value(5, 'm');
      }
    }

    function isDeviceSelfReport(d) {
      return request.auth != null
        && request.auth.uid == d
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'displayName', 'model', 'accessibility', 'notifications', 'statusAt', 'lastCheckId', 'lastCheckAt'
           ])
        && (!('accessibility' in request.resource.data) || request.resource.data.accessibility in ['on', 'off'])
        && (!('notifications' in request.resource.data) || request.resource.data.notifications in ['on', 'off']);
    }

    function isDeviceReenroll(d) {
      return request.auth != null
        && request.auth.uid == d
        && resource.data.get('groupId', null) == null
        && request.resource.data.get('hostUid', d) == d
        && request.resource.data.get('groupId', null) != null
        && roleIn(request.resource.data.groupId, ['device'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'groupId', 'hostUid', 'displayName', 'model', 'enrolledAt', 'accessibility', 'notifications', 'statusAt'
           ])
        && (!('accessibility' in request.resource.data) || request.resource.data.accessibility in ['on', 'off'])
        && (!('notifications' in request.resource.data) || request.resource.data.notifications in ['on', 'off']);
    }

    function isDeviceOwnerRemoval() {
      return resource.data.get('groupId', null) != null
        && roleIn(resource.data.groupId, ['owner'])
        && request.resource.data.groupId == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupId']);
    }
  }
}
